# MINDDO Production Environment
# Copy to /etc/minddo/.env and fill in real values

# Database
DATABASE_URL=postgresql+asyncpg://minddo:YOUR_DB_PASSWORD@localhost:5432/minddo

# Auth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_DAYS=7

# Gnani Prisma STT
GNANI_API_KEY=your-gnani-api-key
GNANI_API_URL=https://api.gnani.ai/prisma/v1/transcribe

# LLM Extraction
LLM_API_KEY=your-llm-api-key
LLM_API_URL=your-llm-api-url

# CORS — set to your actual domain
CORS_ORIGINS=https://yourdomain.com
